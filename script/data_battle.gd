func _init() -> void:
	var count:int = 1
	for rank in all_rank:
		if rank >= 4:
			var hero_code = "s1_%03d" %[count]
			filter_high_npc.append(hero_code)
		count+=1
	
	for i in range(4, 8):
		var bab = "bab_%d" %[i]
		for ii in range(1, 13):
			var stage = "stage_%d" %[ii]
			var index = range(filter_high_npc.size())
			index.shuffle()
			data_main_bab[bab][stage] = [ filter_high_npc[index[0]], filter_high_npc[index[1]], filter_high_npc[index[2]] ]

