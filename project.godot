; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Naga Story"
config/description="Game Turn-Based Card
A stylized 2D turn-based card game built with Godot 4.

Features
Custom card system with unlockable cards (oever 200+ card)
Unique classes, elements, and skills
Story-driven gameplay
Tiered equipment: A, S, SS, SSS, UR
Equipment sets and upgrade system
3 vs 3 Card Battle
Battle system: Story Stages & Infinite Gate mode
In-game shop, gacha box, and lucky spin
Offline redeem code support
Roadmap: Infinite quests"
config/version="1.0.0"
run/main_scene="uid://xbad1c4dwumx"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="uid://flcphh8507uv"

